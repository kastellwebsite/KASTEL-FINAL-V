# --- WordPress (back-office headless) ---
# Adresse de l'installation WordPress, sans barre oblique finale.
# Pas de préfixe NEXT_PUBLIC_ : le domaine du back-office n'a rien à faire dans
# le bundle envoyé au navigateur.
# Tant qu'elle est vide, le site sert le contenu de src/content/site.ts.
WORDPRESS_API_URL=

# Hôtes supplémentaires pour les visuels, séparés par des virgules, si
# l'hébergement sert la médiathèque depuis un autre domaine (CDN, sous-domaine).
# Sans cela l'optimiseur refuse l'image et le visiteur voit une vignette cassée.
# Exemple : cdn.mon-hebergeur.fr,medias.kastell-conseils.fr
MEDIA_HOSTS=

# Secret partagé avec WordPress : à définir ici, puis à recopier à l'identique
# dans wp-config.php sous le nom KASTELL_SECRET.
# Génération : openssl rand -hex 32
REVALIDATE_SECRET=

# --- Envoi des courriels (formulaire de contact) ---
# Une seule des deux clés suffit ; Brevo est prioritaire si les deux sont là.
# Un serveur ne peut pas envoyer un courriel tout seul : sans service dédié et
# sans domaine authentifié, le message part en indésirable ou n'arrive jamais.
BREVO_API_KEY=
RESEND_API_KEY=

# Adresse d'expédition. DOIT appartenir à un domaine vérifié chez le service,
# sinon l'envoi est refusé. Forme acceptée : « Nom <adresse> » ou l'adresse
# seule.
MAIL_EXPEDITEUR="Kastell Conseil <bonjour@kastell-conseils.fr>"

# Destinataire des demandes, seulement s'il diffère de l'adresse de contact du
# site. Sinon : NE PAS CRÉER LA VARIABLE — Vercel refuse une valeur vide, et
# l'absence de la variable est justement ce que le code attend.
# CONTACT_DESTINATAIRE=

# Solution de repli si vous préférez un scénario Zapier ou Make au courriel :
# utilisée seulement quand aucune clé d'envoi n'est renseignée.
# SANS RIEN DE TOUT CELA, LE FORMULAIRE NE PEUT PAS ENVOYER : il le dit au
# visiteur et lui propose d'ouvrir son logiciel de messagerie, message rédigé.
CONTACT_WEBHOOK_URL=

# Destination des adresses e-mail recueillies au téléchargement du manifeste.
# N'importe quel service acceptant un POST JSON : Zapier, Make, Brevo, n8n.
# Sans cette variable, l'adresse est journalisée et le document servi quand même.
MANIFESTE_WEBHOOK_URL=
